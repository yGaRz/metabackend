{
  "AllowedHosts": "*",
  "Logging": {
    "Console": {
      "IncludeScopes": true
    }
  },
  "GraphQLURI": "https://zelik-1.market.metaforcespace.website/api/v1/graphql",
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Graylog" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Graylog",
        "Args": {
          "hostnameOrAddress": "localhost",
          "port": 12201,
          "transportType": "Udp"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "NeoDaoBackend"
    }
  }
}
